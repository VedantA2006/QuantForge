# QuantForge Configuration

# Symbol and Timeframes
QF_SYMBOL=BTCUSDT
QF_INTERVALS=1h,4h
QF_DURATION_YEARS=5

# Generation & Optimization
QF_BATCH_SIZE=20
QF_MAX_TREE_DEPTH=4
QF_INITIAL_BALANCE=10000
QF_COOLDOWN_BARS=3

# Genetic Algorithm
QF_GA_POP_SIZE=50
QF_GA_GENERATIONS=20
QF_GA_EVOLVE_EVERY=5

# Database
QF_MONGO_URI=mongodb://localhost:27017
QF_MONGO_DB=quantforge
QF_LOG_TTL_DAYS=7
QF_TOP_N_BEST=25

# API
QF_API_HOST=0.0.0.0
QF_API_PORT=8000
QF_CORS_ORIGINS=http://localhost:3000,*
QF_LOOP_DELAY=5
QF_MAX_STORED=500

# Advanced Features
QF_SURROGATE=true
QF_SURROGATE_THRESHOLD=0.5
QF_SURROGATE_MIN_SAMPLES=200
QF_SURROGATE_RETRAIN=10
QF_RL=true
QF_RL_RATIO=0.20
QF_RL_LR=0.01
QF_POOL=true
QF_HOF=true
QF_PRUNER=true
QF_PRUNER_MIN_COMPLEXITY=4
